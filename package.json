{
  "name": "@davidalmeida/ui",
  "version": "0.1.2",
  "description": "React + Tailwind 4 components that the CLI copies into your project.",
  "license": "MIT",
  "author": "David Almeida",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/da-ferreira/ui.git"
  },
